{
  "schema_version": 1,
  "id": "probe-state-flow",
  "title": "Startup gates the other two probes; liveness and readiness then judge independently",
  "subtitle": "A readiness failure only removes the Pod from the EndpointSlice. A liveness failure restarts the container.",
  "layout": {
    "icon_cell_w": 190,
    "col_gap": 58,
    "row_gap": 26
  },
  "nodes": [
    {
      "id": "starting",
      "kind": "service",
      "service": "k8s:pod",
      "label": "Container starting",
      "detail": "process is up, not yet judged",
      "col": 0,
      "row": 1,
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "startup",
      "kind": "box",
      "label": "Startup probe",
      "detail": "blocks the other two until it first succeeds",
      "col": 1,
      "row": 1,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "readiness",
      "kind": "box",
      "label": "Readiness probe",
      "detail": "can it take traffic now?",
      "col": 2,
      "row": 0,
      "step": 3,
      "step_at": "top-left"
    },
    {
      "id": "liveness",
      "kind": "box",
      "label": "Liveness probe",
      "detail": "is it stuck beyond recovery?",
      "col": 2,
      "row": 2,
      "step": 4,
      "step_at": "top-left"
    },
    {
      "id": "ready",
      "kind": "box",
      "label": "In the EndpointSlice",
      "detail": "the Service sends traffic",
      "col": 3,
      "row": 0,
      "role": "store"
    },
    {
      "id": "notready",
      "kind": "box",
      "label": "Out of the EndpointSlice",
      "detail": "the process keeps running, kubelet retries",
      "col": 3,
      "row": 1,
      "role": "queue"
    },
    {
      "id": "restart",
      "kind": "box",
      "label": "Container restart",
      "detail": "the restart policy applies",
      "col": 3,
      "row": 2,
      "role": "danger"
    }
  ],
  "edges": [
    {
      "id": "starting-to-startup",
      "source": "starting",
      "target": "startup"
    },
    {
      "id": "startup-to-readiness",
      "source": "startup",
      "target": "readiness"
    },
    {
      "id": "startup-to-liveness",
      "source": "startup",
      "target": "liveness"
    },
    {
      "id": "readiness-to-ready",
      "source": "readiness",
      "target": "ready"
    },
    {
      "id": "readiness-to-notready",
      "source": "readiness",
      "target": "notready",
      "dashed": true
    },
    {
      "id": "liveness-to-restart",
      "source": "liveness",
      "target": "restart",
      "dashed": true
    }
  ]
}
