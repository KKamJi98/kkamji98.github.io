          <mxGeometry x="60" y="60" width="1360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A readiness failure only removes the Pod from the EndpointSlice. A liveness or startup failure restarts the container." style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5F6368;fontSize=13;" vertex="1" parent="1">
