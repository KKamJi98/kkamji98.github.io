  <diagram id="probe-state-flow" name="Startup gates the other two probes; liveness and readiness then judge independently">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="616" background="#FFFFFF" math="0" shadow="0">
