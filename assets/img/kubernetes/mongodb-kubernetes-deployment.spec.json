      "detail": "values drive the topology",
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "sts",
      "kind": "service",
      "label": "StatefulSet",
      "col": 1,
      "row": 0,
      "service": "k8s:sts",
