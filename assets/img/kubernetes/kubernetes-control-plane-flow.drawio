        </mxCell>
        <mxCell id="subtitle" value="It is a hub-and-spoke design: no other control plane component offers a remote API, so every request and state change goes through the API server." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
