          <mxGeometry x="111" y="132" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="routing-table" value="Cilium routing table&#xa;pod CIDR per node" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="291" y="148" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="node-route" value="Static route or BGP&#xa;without it the packet is dropped, not tunnelled" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="523" y="148" width="324" height="54" as="geometry" />
        </mxCell>
        <mxCell id="remote-node" value="Remote node&#xa;receives an unencapsulated packet" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#326CE5;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.kubernetes.icon;prIcon=node;" vertex="1" parent="1">
