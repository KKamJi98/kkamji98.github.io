<mxfile host="kkamji-blog" type="device">
  <diagram id="cilium-native-routing-flow" name="Native routing only works if the underlay already knows every Pod CIDR">
    <mxGraphModel dx="1426" dy="252" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1426" pageHeight="252" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
