        </mxCell>
        <mxCell id="title" value="Native routing only works if the underlay already knows every Pod CIDR" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1358.82" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="There is no encapsulation to hide the Pod address, so a missing route drops the packet. A static route or BGP is what supplies it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1358.82" height="22" as="geometry" />
