        <mxCell id="title" value="A pod stuck Terminating is waiting on a finalizer or a volume, not on the kubelet" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1373.18" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The API server keeps the object until every finalizer clears, so a deletionTimestamp alone never removes it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
