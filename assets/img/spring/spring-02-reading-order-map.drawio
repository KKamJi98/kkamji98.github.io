<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="spring-02-reading-order-map" name="Curriculum Reading Order">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="660" pageHeight="940" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" parent="1" vertex="1" value="Series 1 - The Path of a Request&#xa;1. Big picture: HTTP request flow&#xa;2. IoC / DI and Beans&#xa;3. Spring MVC / DispatcherServlet&#xa;4. Spring Boot autoconfig / fat jar" style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;shadow=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;strokeWidth=1.25;">
          <mxGeometry x="100" y="36" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" vertex="1" value="Series 2 - Under the App: JVM and Memory&#xa;5. CS memory basics (process layout, stack/heap)&#xa;6. JVM memory model (heap / metaspace / off-heap)&#xa;7. Container exec / buildpack memory&#xa;8. GC basics and G1GC&#xa;9. GC tuning / JDK version changes" style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;shadow=0;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;strokeWidth=1.25;">
          <mxGeometry x="100" y="196" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" vertex="1" value="Series 3 - Two Concurrency Paths: MVC vs WebFlux&#xa;10. Non-blocking streams / backpressure&#xa;11. WebFlux / netty event loop&#xa;12. MVC vs WebFlux: when to use" style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;shadow=0;fillColor=#E8EAED;strokeColor=#9AA0A6;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;strokeWidth=1.25;">
          <mxGeometry x="100" y="356" width="460" height="102" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" vertex="1" value="Series 4 - Data Layer&#xa;13. JPA / Hibernate / persistence context&#xa;14. @Transactional / propagation&#xa;15. N+1 / performance" style="rounded=1;whiteSpace=wrap;html=0;arcSize=12;shadow=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontStyle=1;strokeWidth=1.25;">
          <mxGeometry x="100" y="498" width="460" height="102" as="geometry" />
        </mxCell>
