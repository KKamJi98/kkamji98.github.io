<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-16-entity-states" name="Four entity states, and only one of them is tracked">
    <mxGraphModel dx="848" dy="420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="848" pageHeight="420" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="824.48" height="396.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Four entity states, and only one of them is tracked" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="780.48" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="EntityManager calls drive every transition. Changes to a detached instance are not written anywhere." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="780.48" height="22" as="geometry" />
        </mxCell>
        <mxCell id="transient" value="transient (new)&#xa;not in any persistence context" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="180" width="215" height="54" as="geometry" />
        </mxCell>
        <mxCell id="managed" value="managed (persistent)&#xa;in the context, changes tracked" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="317" y="180" width="222" height="54" as="geometry" />
        </mxCell>
        <mxCell id="detached" value="detached&#xa;has an id, no longer tracked" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="609" y="104" width="203" height="54" as="geometry" />
        </mxCell>
        <mxCell id="removed" value="removed&#xa;scheduled for DELETE at flush" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="605" y="256" width="209" height="54" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Database&#xa;flush writes what the context tracked" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="297" y="332" width="260" height="54" as="geometry" />
