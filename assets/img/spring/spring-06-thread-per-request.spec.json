{
  "schema_version": 1,
  "id": "spring-06-thread-per-request",
  "title": "One worker fully occupies one request, blocking included",
  "subtitle": "Concurrency is bounded by the pool size, so slow I/O turns into a queue rather than into more throughput.",
  "layout": {
    "col_gap": 48,
    "row_gap": 14
  },
  "containers": [
    {
      "id": "pool",
      "kind": "plain",
      "label": "Tomcat thread pool (max around 200)",
      "members": [
        "w1",
        "w2",
        "w3",
        "overflow"
      ]
    }
  ],
  "nodes": [
    {
      "id": "reqA",
      "kind": "box",
      "label": "Request A",
      "col": 0,
      "row": 0
    },
    {
