      "w": 400
    },
    {
      "id": "w2",
      "kind": "box",
      "label": "worker-2 serves Request B",
      "col": 1,
      "row": 1,
      "detail": "blocked on I/O, still held",
      "role": "compute",
      "w": 400
    },
    {
      "id": "w3",
      "kind": "box",
      "label": "worker-3 serves Request C",
      "col": 1,
      "row": 2,
      "detail": "blocked on I/O, still held",
      "role": "compute",
      "w": 400
    },
    {
      "id": "overflow",
      "kind": "box",
      "label": "Pool full",
