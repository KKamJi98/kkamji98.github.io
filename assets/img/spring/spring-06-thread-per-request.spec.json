      "kind": "box",
      "label": "Request B",
      "col": 0,
      "row": 1
    },
    {
      "id": "reqC",
      "kind": "box",
      "label": "Request C",
      "col": 0,
      "row": 2
    },
    {
      "id": "reqMore",
      "kind": "box",
      "label": "Request D, E, ...",
      "col": 0,
      "row": 3,
      "role": "queue"
    },
    {
      "id": "w1",
      "kind": "box",
      "label": "worker-1 serves Request A",
      "col": 1,
      "row": 0,
