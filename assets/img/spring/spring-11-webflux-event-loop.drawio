<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-11-webflux-event-loop" name="A handful of event loop threads serve many connections">
    <mxGraphModel dx="1025" dy="406" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1025" pageHeight="406" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1001.58" height="382.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="A handful of event loop threads serve many connections" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="957.58" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="While one connection waits on I/O, the same thread serves another, which is why the pool tracks CPU cores rather than requests." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="957.58" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="Netty event loop pool (threads track the CPU core count)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="414.79" y="104" width="464" height="188" as="geometry" />
        </mxCell>
        <mxCell id="conns" value="Many connections&#xa;A, B, C, D, E, F, ..." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="146.79" y="146" width="220" height="146" as="geometry" />
        </mxCell>
        <mxCell id="el1" value="event-loop-1 serves A, C, E&#xa;never blocks" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="436.79" y="146" width="420" height="54" as="geometry" />
        </mxCell>
        <mxCell id="el2" value="event-loop-2 serves B, D, F&#xa;never blocks" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="436.79" y="216" width="420" height="54" as="geometry" />
        </mxCell>
        <mxCell id="elnote" value="While one connection's I/O is pending the thread picks up another connection instead of waiting." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="146.79" y="308" width="732" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cmp" value="Spring MVC would need one blocked thread per in-flight request for the same work." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="146.79" y="348" width="732" height="24" as="geometry" />
        </mxCell>
        <mxCell id="conns-to-el1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.1849;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="conns" target="el1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conns-to-el2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.6644;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="conns" target="el2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
