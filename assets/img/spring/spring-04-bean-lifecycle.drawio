        </mxCell>
        <mxCell id="title" value="A singleton bean is built once and then occupies the heap for the process lifetime" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1027.3" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The init callback runs after injection, not after instantiation, which is why a dependency is safe to use there." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
