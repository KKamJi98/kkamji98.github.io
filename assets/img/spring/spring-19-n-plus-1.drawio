<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-19-n-plus-1" name="One query for the parents, then one more for every parent">
    <mxGraphModel dx="806" dy="366" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="806" pageHeight="366" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="782.92" height="342.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="One query for the parents, then one more for every parent" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="738.92" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The extra queries come from touching a lazy collection inside a loop, not from the original query." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="738.92" height="22" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="Query 1&#xa;SELECT * FROM orders, returning N rows" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="123.36" y="104" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="Then, once per order&#xa;SELECT * FROM items WHERE order_id = ?, as the lazy collection is touched" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="123.36" y="172" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="total" value="1 + N queries&#xa;the N+1 selects problem" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="123.36" y="240" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="spring-19-n-plus-1-note" value="Nothing about the mapping is wrong. The access pattern is what multiplies the query count." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
