          <mxGeometry x="207.89" y="104" width="520" height="54" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="AOP proxy with TransactionInterceptor&#xa;the only place the annotation is honoured" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
