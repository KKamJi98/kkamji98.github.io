<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-17-transactional-proxy" name="@Transactional is a proxy, so a self-call skips it entirely">
    <mxGraphModel dx="935" dy="682" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="935" pageHeight="682" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="911.1" height="658.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="@Transactional is a proxy, so a self-call skips it entirely" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="867.1" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The interceptor lives on the proxy. Calling the method through this bypasses the proxy and the transaction with it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
