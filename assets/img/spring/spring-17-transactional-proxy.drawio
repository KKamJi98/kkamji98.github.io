          <mxGeometry x="207.89" y="296" width="520" height="54" as="geometry" />
        </mxCell>
        <mxCell id="method" value="@Transactional method&#xa;the persistence context is active here" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
