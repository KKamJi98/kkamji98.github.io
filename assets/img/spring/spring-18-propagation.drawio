          <mxGeometry x="12" y="12" width="978.0" height="442.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="REQUIRED joins one transaction; REQUIRES_NEW creates a second one" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="934.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Under REQUIRED an inner rollback marks the whole transaction rollback-only, which is what surprises callers." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="934.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="spring-18-propagation-l" value="PROPAGATION_REQUIRED (default)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="444" height="328" as="geometry" />
        </mxCell>
        <mxCell id="spring-18-propagation-r" value="PROPAGATION_REQUIRES_NEW" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="104" width="444" height="328" as="geometry" />
        </mxCell>
        <mxCell id="lo" value="outer @Transactional&#xa;starts the physical transaction" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="li" value="inner @Transactional (REQUIRED)&#xa;joins the existing one" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lr" value="one physical transaction" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="286" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="ln" value="inner rollback&#xa;marks the whole transaction rollback-only" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="356" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="ro" value="outer @Transactional&#xa;suspended while the inner runs" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="ri" value="inner @Transactional (REQUIRES_NEW)&#xa;its own physical transaction" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
