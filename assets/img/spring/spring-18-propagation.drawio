<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-18-propagation" name="REQUIRED joins one transaction; REQUIRES_NEW creates a second one">
    <mxGraphModel dx="1002" dy="466" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1002" pageHeight="466" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
