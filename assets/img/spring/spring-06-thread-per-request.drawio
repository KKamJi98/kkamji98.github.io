        <mxCell id="reqC" value="Request C" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="86.47" y="282" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="reqMore" value="Request D, E, ..." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="86.47" y="350" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="worker-1 serves Request A&#xa;blocked on I/O, still held" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="351.47" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="worker-2 serves Request B&#xa;blocked on I/O, still held" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="351.47" y="214" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="worker-3 serves Request C&#xa;blocked on I/O, still held" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="351.47" y="282" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="overflow" value="Pool full&#xa;wait queue, then reject or time out" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="351.47" y="350" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="note-stack" value="Each worker carries its own call stack in native memory, which is why the pool size also costs memory." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
