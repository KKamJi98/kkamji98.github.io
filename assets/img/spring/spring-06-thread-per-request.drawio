          <mxGeometry x="86.47" y="146" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="reqB" value="Request B" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
