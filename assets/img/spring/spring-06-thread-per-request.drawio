        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="835.7" height="474.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="One worker fully occupies one request, blocking included" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="791.7" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Concurrency is bounded by the pool size, so slow I/O turns into a queue rather than into more throughput." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="791.7" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="Tomcat thread pool (max around 200)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="329.47" y="104" width="444" height="322" as="geometry" />
        </mxCell>
