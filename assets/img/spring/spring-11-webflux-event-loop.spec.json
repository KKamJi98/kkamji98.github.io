      "members": [
        "el1",
        "el2"
      ]
    }
  ],
  "nodes": [
    {
      "id": "conns",
      "kind": "box",
      "label": "Many connections",
      "col": 0,
      "row": 0,
      "detail": "A, B, C, D, E, F, ...",
      "rowspan": 2,
      "w": 220
    },
    {
      "id": "el1",
      "kind": "box",
      "label": "event-loop-1 serves A, C, E",
