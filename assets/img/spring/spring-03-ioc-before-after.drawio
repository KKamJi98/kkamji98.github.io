<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-03-ioc-before-after" name="The container owning construction is what removes the coupling">
    <mxGraphModel dx="1002" dy="436" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1002" pageHeight="436" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="978.0" height="412.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="The container owning construction is what removes the coupling" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="934.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The classes do not change shape. What changes is who calls new, and that is enough to make each one testable alone." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="934.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="spring-03-ioc-before-after-l" value="Before: manual new (tight coupling)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="444" height="258" as="geometry" />
        </mxCell>
        <mxCell id="spring-03-ioc-before-after-r" value="After: IoC container (loose coupling)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="104" width="444" height="258" as="geometry" />
        </mxCell>
        <mxCell id="ctrl-before" value="OrderController&#xa;news its own OrderService" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="svc-before" value="OrderService&#xa;news its own OrderRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="repo-before" value="OrderRepository&#xa;concrete type baked in" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="286" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="ctrl-after" value="OrderController (bean)&#xa;receives OrderService" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="svc-after" value="OrderService (bean)&#xa;receives OrderRepository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="repo-after" value="OrderRepository (bean)&#xa;swappable behind its type" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="286" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="spring-03-ioc-before-after-note" value="Construction baked into the code is the coupling. The container building and injecting is what breaks it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="378" width="890" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ctrl-before-to-svc-before" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl-before" target="svc-before">
