          <mxGeometry x="12" y="12" width="978.0" height="482.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="The two stacks differ in what a waiting request costs" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="934.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="MVC pays a thread and works with blocking libraries; WebFlux pays a subscription and requires non-blocking ones." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="934.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="spring-13-mvc-vs-webflux-l" value="Spring MVC (thread-per-request)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="444" height="328" as="geometry" />
        </mxCell>
        <mxCell id="spring-13-mvc-vs-webflux-r" value="Spring WebFlux (event loop)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="104" width="444" height="328" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Execution&#xa;synchronous and imperative" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Threads&#xa;one per request, hundreds" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Blocking libraries&#xa;JPA and JDBC work as they are" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
