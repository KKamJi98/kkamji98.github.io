        </mxCell>
        <mxCell id="title" value="One worker thread is held for the whole request, blocking included" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="829.4" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Everything from the connector to the repository runs on that one thread, which is what bounds MVC concurrency." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
