<mxfile host="kkamji-blog" type="device">
  <diagram id="spring-09-blocking-vs-reactive" name="Blocking holds a thread through the wait; non-blocking hands it back">
    <mxGraphModel dx="1002" dy="436" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1002" pageHeight="436" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="978.0" height="412.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Blocking holds a thread through the wait; non-blocking hands it back" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="934.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The declarative style is not the point. Releasing the thread during I/O is." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="934.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="spring-09-blocking-vs-reactive-l" value="Blocking (imperative)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="444" height="258" as="geometry" />
        </mxCell>
        <mxCell id="spring-09-blocking-vs-reactive-r" value="Non-blocking (event driven)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="104" width="444" height="258" as="geometry" />
        </mxCell>
        <mxCell id="lb1" value="call db.query()" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lb2" value="thread blocked&#xa;held for the whole wait, doing nothing" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lb3" value="use(result)&#xa;resumes on the same thread" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="286" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rb1" value="declare the stream&#xa;query().map(...).subscribe(...)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="146" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rb2" value="thread released&#xa;free to serve another request" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="216" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rb3" value="data arrives, onNext runs&#xa;possibly on a different thread" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="546" y="286" width="400" height="54" as="geometry" />
        </mxCell>
        <mxCell id="spring-09-blocking-vs-reactive-note" value="Blocking spends a thread on waiting. Non-blocking spends a callback, which is why a small pool can carry many connections." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="378" width="890" height="24" as="geometry" />
        </mxCell>
