{
  "schema_version": 1,
  "id": "gcp-iam-inheritance",
  "title": "IAM grants accumulate down the hierarchy; they never subtract",
  "subtitle": "The effective policy on a resource is the union of every binding above it, so a broad grant high up cannot be narrowed lower down.",
  "layout": {
    "col_gap": 56,
    "row_gap": 26
  },
  "nodes": [
