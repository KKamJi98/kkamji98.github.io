      "row": 0,
      "detail": "grant: Viewer",
      "role": "process"
    },
    {
      "id": "folder",
      "kind": "box",
      "label": "Folder: engineering",
      "col": 0,
      "row": 1,
      "detail": "no binding of its own"
    },
    {
      "id": "project",
      "kind": "box",
      "label": "Project: app-prod",
      "col": 0,
      "row": 2,
      "detail": "grant: Editor",
      "role": "process"
    },
    {
      "id": "result",
      "kind": "box",
      "label": "Effective on app-prod",
      "col": 0,
      "row": 3,
      "detail": "Viewer + Editor, the union of both",
      "role": "store"
    }
  ],
  "edges": [
    {
      "id": "org-to-folder",
      "source": "org",
      "target": "folder"
    },
    {
