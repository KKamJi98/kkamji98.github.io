        </mxCell>
        <mxCell id="subtitle" value="The effective policy on a resource is the union of every binding above it, so a broad grant high up cannot be narrowed lower down." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
