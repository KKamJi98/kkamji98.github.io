      "target": "microtask"
    },
    {
      "id": "microtask-to-timers",
      "source": "microtask",
      "target": "timers"
    },
    {
      "id": "timers-to-poll",
      "source": "timers",
      "target": "poll"
    },
    {
      "id": "poll-to-check",
      "source": "poll",
      "target": "check"
    },
    {
