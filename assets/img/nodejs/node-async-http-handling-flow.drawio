<mxfile host="kkamji-blog" type="device">
  <diagram id="node-async-http-handling-flow" name="One place owns the response, and every failure path goes through it">
    <mxGraphModel dx="1477" dy="491" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1477" pageHeight="491" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1453.98" height="467.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="One place owns the response, and every failure path goes through it" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1409.98" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid lines are the work and the single terminal response. Dashed lines are a timeout or a client disconnect cancelling downstream work; a rejected Promise is not itself an HTTP response." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1409.98" height="22" as="geometry" />
        </mxCell>
        <mxCell id="error-boundary" value="Error boundary: one owner for the response" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="556.99" y="188" width="590" height="218" as="geometry" />
        </mxCell>
        <mxCell id="client" value="Client" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="44.99" y="250" width="200" height="54" as="geometry" />
        </mxCell>
        <mxCell id="request-event" value="request event&#xa;the server emits it" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="290.99" y="250" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="handler" value="handleRequest()&#xa;no waiting of its own" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="598.99" y="250" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="fetch-json" value="fetchJson()&#xa;awaits the upstream call" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="884.99" y="250" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="upstream" value="Upstream HTTP service&#xa;may be slow or never answer" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1192.99" y="250" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="promise" value="Promise pending&#xa;a rejection is not a response;&#xa;the boundary maps it to one" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="884.99" y="326" width="240" height="63" as="geometry" />
        </mxCell>
        <mxCell id="timeout" value="timeout&#xa;turns a stall into an error" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1192.99" y="104" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="abort-controller" value="AbortController&#xa;releases the socket and the promise" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1192.99" y="330" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="response-owner" value="writeResponse()&#xa;the only writer, success or failure" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="598.99" y="330" width="240" height="54" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Without a timeout and an abort signal the promise stays pending, the socket stays open, and the client waits forever." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="44.99" y="433" width="1388" height="24" as="geometry" />
        </mxCell>
