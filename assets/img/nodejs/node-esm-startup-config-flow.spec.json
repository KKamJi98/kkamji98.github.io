{
  "schema_version": 1,
  "id": "node-esm-startup-config-flow",
  "title": "Config is validated before the server binds, so a bad value fails at start-up",
  "subtitle": "The CLI supplies the environment, then the ESM graph loads. Only a valid configuration reaches the error listener and listen(), and a resolve failure never gets that far.",
  "layout": {
    "col_gap": 44,
    "row_gap": 22
  },
  "nodes": [
