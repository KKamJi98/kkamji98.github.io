      "step": 1,
      "step_at": "top-left",
      "w": 250
    },
    {
      "id": "environment",
      "kind": "box",
      "label": "Environment",
      "col": 1,
      "row": 1,
      "detail": "--env-file and process.env",
      "role": "external",
      "w": 250,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "main-module",
      "kind": "box",
      "label": "main.mjs",
      "col": 2,
      "row": 1,
      "detail": "bootstrap entry point",
      "role": "process",
      "step": 3,
      "step_at": "top-left",
      "w": 250
    },
    {
      "id": "config-module",
      "kind": "box",
      "label": "config.mjs",
      "col": 3,
      "row": 1,
      "detail": "imported before the server",
      "role": "process",
      "step": 4,
      "step_at": "top-left",
      "w": 250
    },
    {
      "id": "config-validation",
      "kind": "box",
      "label": "Parse and validate config",
      "col": 4,
      "row": 1,
      "detail": "fail here, not at first request",
