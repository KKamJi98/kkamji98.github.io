      "step": 5,
      "step_at": "top-left",
      "w": 250
    },
    {
      "id": "server-module",
      "kind": "box",
      "label": "server.mjs",
      "col": 5,
      "row": 1,
      "detail": "createServer",
      "role": "process",
      "step": 6,
      "step_at": "top-left",
      "w": 250
    },
    {
      "id": "error-listener",
      "kind": "box",
