        </mxCell>
        <mxCell id="title" value="nextTick and microtasks drain before the loop moves to the next phase" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1322.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Both queues run to exhaustion between phases, so a recursive nextTick can starve the poll phase entirely." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
