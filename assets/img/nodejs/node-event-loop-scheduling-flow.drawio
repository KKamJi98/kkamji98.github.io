          <mxGeometry x="360" y="112" width="344" height="238" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="Synchronous callback&#xa;runs to completion first" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
