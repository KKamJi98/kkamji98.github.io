          <mxGeometry x="2112" y="132" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="Ready: HTTP 200&#xa;the readiness probe can pass" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
