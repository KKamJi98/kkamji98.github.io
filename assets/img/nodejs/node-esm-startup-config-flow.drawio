<mxfile host="kkamji-blog" type="device">
  <diagram id="node-esm-startup-config-flow" name="Config is validated before the server binds, so a bad value fails at start-up">
    <mxGraphModel dx="2690" dy="296" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2690" pageHeight="296" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="2666.0" height="272.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Config is validated before the server binds, so a bad value fails at start-up" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="2622.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The CLI supplies the environment, then the ESM graph loads. Only a valid configuration reaches the error listener and listen(), and a resolve failure never gets that far." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="2622.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="node-cli" value="Node CLI&#xa;node main.mjs" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="54" y="132" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="environment" value="Environment&#xa;--env-file and process.env" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#9AA0A6;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="348" y="132" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="main-module" value="main.mjs&#xa;bootstrap entry point" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="642" y="132" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="config-module" value="config.mjs&#xa;imported before the server" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="936" y="132" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="config-validation" value="Parse and validate config&#xa;fail here, not at first request" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
