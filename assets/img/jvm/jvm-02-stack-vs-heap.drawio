  <diagram id="jvm-02-stack-vs-heap" name="The frame holds the reference; the heap holds the object">
    <mxGraphModel dx="1006" dy="262" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1006" pageHeight="262" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
