          <mxGeometry x="12" y="12" width="982.0" height="238.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="The frame holds the reference; the heap holds the object" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="938.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Returning from a method pops the local and the reference. The object stays until no reference reaches it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="938.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="code" value="void process() {&#xa;    int count = 10;&#xa;    Order order = new Order();&#xa;}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#9AA0A6;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="stackr" value="Stack: the process() frame&#xa;count = 10&#xa;order = a reference" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="388" y="112" width="280" height="63" as="geometry" />
        </mxCell>
        <mxCell id="heapr" value="Heap (shared)&#xa;the Order object itself" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="722" y="116" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="note" value="On return, count and the reference pop with the frame. The Order object survives until it is unreachable." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="204" width="938" height="24" as="geometry" />
