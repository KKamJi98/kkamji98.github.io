<mxfile host="kkamji-blog" type="device">
  <diagram id="jvm-11-capstone-diagnosis" name="Old 점유가 높다는 관측만으로는 누수와 정상 동작을 구분할 수 없다">
    <mxGraphModel dx="1098" dy="376" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1098" pageHeight="376" math="0" shadow="0" background="#FFFFFF">
