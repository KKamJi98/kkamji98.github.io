<mxfile host="kkamji-blog" type="device">
  <diagram id="jvm-09-gc-tuning-params" name="Five knobs, and only one of them is a goal rather than a limit">
    <mxGraphModel dx="965" dy="473" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="965" pageHeight="473" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="941.26" height="449.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Five knobs, and only one of them is a goal rather than a limit" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="897.26" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="MaxGCPauseMillis states an intent and lets G1 size the young generation; the others pin values and remove that freedom." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="897.26" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="-Xms and -Xmx&#xa;initial and maximum heap" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="202.63" y="104" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="-XX:MaxGCPauseMillis  (default 200)&#xa;a pause goal; G1 sizes the young generation to meet it" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="202.63" y="172" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="-XX:MaxNewSize or -Xmn&#xa;caps the young generation; Oracle warns that pinning it&#xa;turns off pause-time control" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="202.63" y="240" width="560" height="63" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="-XX:InitiatingHeapOccupancyPercent&#xa;when concurrent marking starts, adaptive by default" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="202.63" y="317" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="-Xlog:gc* and JFR&#xa;how you observe any of the above" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="202.63" y="385" width="560" height="54" as="geometry" />
        </mxCell>
      </root>
