        </mxCell>
        <mxCell id="title" value="A faster G1 raises the Old generation baseline without any leak" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="790.36" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Same pause goal, shorter pauses, so G1 grows Eden, collects young less often, and promotes more." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="790.36" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Newer JDK: G1 pauses get shorter" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="132" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Same pause goal means G1 grows Eden" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="228" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Fewer minor collections" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="324" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Adaptive IHOP defers concurrent marking" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="420" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="More promotion into Old" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="516" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Old stays high, then drops on mixed GC: a sawtooth" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="612" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="note" value="This is a GC behaviour shift, not a memory leak. It is more pronounced when the heap is generous relative to the live set." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="680" width="790" height="24" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="The lever is capping the young generation, which lowers promotion but also gives up adaptive sizing." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
