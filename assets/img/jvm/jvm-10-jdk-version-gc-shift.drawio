  <diagram id="jvm-10-jdk-version-gc-shift" name="A faster G1 raises the Old generation baseline without any leak">
    <mxGraphModel dx="858" dy="776" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="858" pageHeight="776" math="0" shadow="0" background="#FFFFFF">
