        <mxCell id="subtitle" value="구체적 수치는 워크로드별로 측정해 정한다. 단일 정답값이 아니라 baseline과의 비교 관측이 기준이다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="994.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="causes" value="관찰된 원인 (누수 아님)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="474" height="258" as="geometry" />
        </mxCell>
        <mxCell id="levers" value="처방 (levers)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="554" y="104" width="474" height="350" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="JDK 업그레이드와 adaptive IHOP&#xa;같은 워크로드에서 Old 점유 baseline이 달라진다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="G1의 점진 회수&#xa;IHOP 전까지 Old를 높게 유지한다 (설계상 정상)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="216" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="off-heap은 -Xmx 바깥&#xa;netty direct memory는 heap만 보면 드러나지 않는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="286" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="MaxNewSize&#xa;young 상한으로 Old 증가 속도와 승격을 관리" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="576" y="146" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="IHOP 하향&#xa;mixed GC를 조기 트리거해 Old 회수를 앞당김" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="576" y="216" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="MaxDirectMemorySize 명시&#xa;off-heap 상한을 코드 밖에서 고정" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="576" y="286" width="430" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="컨테이너 메모리 &gt;= heap + off-heap&#xa;buildpack 계산과 실제 사용량을 함께 본다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
