      "col": 0,
      "row": 0
    },
    {
      "id": "gas-meter",
      "kind": "box",
      "label": "gasUsed 21000",
      "detail": "effectiveGasPrice 1.000000001 gwei",
      "role": "compute",
      "col": 1,
      "row": 0
    },
    {
      "id": "success-receipt",
      "kind": "box",
      "label": "receipt status 0x1",
      "detail": "block 1, fee 21000000021000 wei",
      "role": "queue",
      "col": 2,
      "row": 0
    }
  ],
  "edges": [
    {
      "id": "tx-to-gas",
      "source": "type2-tx",
      "target": "gas-meter",
      "emphasis": true
    },
    {
      "id": "gas-to-receipt",
      "source": "gas-meter",
      "target": "success-receipt"
    }
  ]
