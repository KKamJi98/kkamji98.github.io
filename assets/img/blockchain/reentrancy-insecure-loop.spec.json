      "col": 1,
      "row": 0
    },
    {
      "id": "receive",
      "kind": "box",
      "label": "attacker receive",
      "detail": "vault.balance >= 1 ETH",
      "role": "external",
      "col": 1,
      "row": 1
    },
    {
      "id": "reenter",
      "kind": "box",
