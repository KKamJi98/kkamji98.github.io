      "kind": "box",
      "label": "sequencer",
      "detail": "order and execute",
      "role": "process",
      "col": 1,
      "row": 0
    },
    {
      "id": "l1",
      "kind": "box",
      "label": "L1 batch",
      "detail": "calldata or blob",
      "role": "store",
      "col": 2,
      "row": 0
    }
  ],
  "edges": [
    {
      "id": "u-to-s",
      "source": "user",
      "target": "seq",
      "emphasis": true
    },
    {
      "id": "s-to-l1",
