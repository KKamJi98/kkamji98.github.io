        <mxCell id="title" value="A stateless filter needs a return rule; a stateful one already knows the flow" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1139.04" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Connection tracking is what removes the second rule, and what makes the return path implicit." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1139.04" height="22" as="geometry" />
