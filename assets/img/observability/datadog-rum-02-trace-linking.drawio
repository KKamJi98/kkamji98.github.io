<mxfile host="kkamji-blog" type="device">
  <diagram id="datadog-rum-02-trace-linking" name="RUM Resource와 백엔드 trace를 같은 trace_id로 잇는다">
    <mxGraphModel dx="795" dy="300" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="795" pageHeight="300" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="771.28" height="276.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="RUM Resource와 백엔드 trace를 같은 trace_id로 잇는다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="727.28" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="브라우저 SDK가 요청 헤더에 trace_id를 주입하고 백엔드 tracer가 그것을 이어받아야 프론트 지연과 백엔드 span이 한 화면에서 연결된다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="727.28" height="22" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="Browser + RUM Browser SDK&#xa;사용자 클릭에서 fetch 또는 XHR 요청이 발생&#xa;요청 헤더에 trace_id 주입" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="54" y="144" width="203" height="63" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="Backend service + APM tracer&#xa;주입된 trace_id를 이어받아 span 생성" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="313" y="148" width="203" height="54" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Database&#xa;느린 SQL이 백엔드 병목으로 드러나는 지점" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.generic_database;" vertex="1" parent="1">
          <mxGeometry x="642" y="132" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="note" value="allowedTracingUrls에 백엔드 origin이 등록되어 있어야 헤더가 주입된다. 등록이 빠지면 두 데이터가 각각 남고 연결되지 않는다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="242" width="707" height="24" as="geometry" />
        </mxCell>
        <mxCell id="browser-step" value="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1A73E8;strokeColor=#1A73E8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="124" width="26" height="26" as="geometry" />
