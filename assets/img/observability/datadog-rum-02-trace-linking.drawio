          <mxGeometry x="293" y="128" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="db-step" value="3" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1A73E8;strokeColor=#1A73E8;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="622" y="112" width="26" height="26" as="geometry" />
