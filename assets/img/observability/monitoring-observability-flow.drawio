        </mxCell>
        <mxCell id="subtitle" value="Monitoring is an operational activity over conditions you already chose. Observability is a property of the system that decides whether a new question can be answered at all." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
