        </mxCell>
        <mxCell id="title" value="A WAF Challenge only completes on a route that can run the interstitial" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1722.26" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The 202 challenge needs a browser navigation to execute the JavaScript; a POST or OPTIONS request has nowhere to run it." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
