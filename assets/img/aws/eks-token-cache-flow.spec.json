      "row": 0,
      "rowspan": 2,
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "exec",
      "kind": "box",
      "label": "kubeconfig exec credential",
      "detail": "runs on every single invocation",
      "col": 1,
      "row": 0,
      "rowspan": 2,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "script",
      "kind": "box",
      "label": "eks-token-cache.sh",
      "detail": "caches per cluster and profile,\nchecks remaining validity",
      "col": 2,
      "row": 0,
      "rowspan": 2,
      "step": 3,
      "step_at": "top-left",
      "role": "compute"
    },
    {
