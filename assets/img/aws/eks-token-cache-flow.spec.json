{
  "schema_version": 1,
  "id": "eks-token-cache-flow",
  "title": "Every kubectl call mints a new EKS token unless a wrapper caches it",
  "subtitle": "The kubeconfig exec block runs on each invocation, so the fix is to point it at a script that reuses a token until it is close to expiry.",
  "layout": {
    "icon_cell_w": 176,
    "col_gap": 54,
    "row_gap": 26
  },
