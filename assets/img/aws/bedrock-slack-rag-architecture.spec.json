{
  "schema_version": 1,
  "id": "bedrock-slack-rag-architecture",
  "title": "Google Docs become citable answers in a Slack thread",
  "subtitle": "One parse produces both the Markdown body and the citation metadata, which is what makes a deep link back to the source possible.",
  "layout": {
    "icon_cell_w": 156,
    "col_gap": 42,
    "row_gap": 30
  },
  "containers": [
    {
      "id": "lane-ingest",
      "kind": "plain",
      "label": "1. Document ingestion",
      "members": [
        "gdocs",
        "apps-script",
        "n8n-sync",
        "docs-api",
        "parser",
        "citation",
        "s3-artifacts",
        "kb",
        "s3-vectors"
      ]
    },
    {
      "id": "lane-query",
      "kind": "plain",
      "label": "2. Slack query runtime",
      "members": [
        "mention",
        "n8n-chat",
        "retrieve",
        "rerank",
        "gate",
        "llm",
        "reply",
        "eval"
      ]
    }
  ],
