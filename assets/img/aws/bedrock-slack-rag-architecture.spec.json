    {
      "id": "n8n-sync",
      "kind": "box",
      "label": "n8n sync workflow",
      "col": 2,
      "row": 0,
      "detail": "AssumeRole"
    },
    {
      "id": "docs-api",
      "kind": "box",
      "label": "Docs API",
      "col": 3,
      "row": 0,
