          <mxGeometry x="68" y="134" width="266" height="166" as="geometry" />
        </mxCell>
        <mxCell id="exec" value="kubeconfig exec credential&#xa;runs on every single invocation" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
