        <mxCell id="title" value="Every kubectl call mints a new EKS token unless a wrapper caches it" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1427.46" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The kubeconfig exec block runs on each invocation, so the fix is to point it at a script that reuses a token until it is close to expiry." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
