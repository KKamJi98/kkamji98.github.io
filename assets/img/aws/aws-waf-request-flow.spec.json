      "row": 0,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "origin",
      "kind": "service",
      "service": "ec2",
      "label": "Application origin",
      "detail": "EC2, NLB, EKS\nmust be reachable only through the entry point",
      "col": 3,
      "row": 0,
      "step": 3,
      "step_at": "top-left"
    },
    {
      "id": "blocked",
      "kind": "box",
      "label": "Blocked",
      "detail": "403 without reaching the origin",
      "role": "danger",
      "col": 3,
      "row": 1
    }
  ],
  "edges": [
    {
      "id": "client-request",
      "source": "client",
      "target": "entry"
    },
    {
      "id": "inspect",
      "source": "entry",
      "target": "webacl",
      "emphasis": true
    },
    {
      "id": "allow",
      "source": "webacl",
      "target": "origin",
      "emphasis": true
    },
    {
      "id": "block",
      "source": "webacl",
      "target": "blocked",
      "dashed": true
    }
