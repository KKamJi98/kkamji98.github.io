{
  "schema_version": 1,
  "id": "aws-waf-request-flow",
  "title": "AWS WAF evaluates a request at the entry point, not at the origin",
  "subtitle": "Rules run in priority order; the Web ACL default action decides anything no rule matched.",
  "layout": {
    "icon_cell_w": 186,
    "col_gap": 62,
    "row_gap": 44
  },
  "containers": [
    {
      "id": "aws-cloud",
      "kind": "aws_cloud",
      "label": "AWS Cloud",
      "members": [
        "entry",
        "webacl",
        "origin",
        "blocked"
      ]
    },
    {
      "id": "protected",
      "kind": "plain",
      "label": "Protected entry point",
      "members": [
        "entry",
        "webacl"
      ]
    }
  ],
  "nodes": [
    {
      "id": "client",
      "kind": "service",
      "service": "client",
      "label": "Client",
      "detail": "HTTP(S) request",
      "col": 0,
      "row": 0
    },
    {
      "id": "entry",
      "kind": "service",
      "service": "cloudfront",
      "label": "CloudFront, ALB\nor API Gateway",
