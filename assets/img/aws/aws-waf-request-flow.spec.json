      "col": 1,
      "row": 0,
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "webacl",
      "kind": "service",
      "service": "waf",
      "label": "AWS WAF Web ACL",
      "detail": "rules by priority\nAllow, Block, Count, CAPTCHA",
