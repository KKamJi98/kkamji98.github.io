<mxfile host="kkamji-blog" type="device">
  <diagram id="analytics-stack-11-iceberg-cow-vs-mor" name="Copy-on-Write pays at write time, Merge-on-Read pays at read time">
    <mxGraphModel dx="1162" dy="408" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1162" pageHeight="408" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1138.98" height="384.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Copy-on-Write pays at write time, Merge-on-Read pays at read time" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1094.98" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Both produce the same query result; they differ in which side of the workload absorbs the cost." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1094.98" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c-cow" value="Copy-on-Write" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="584" height="198" as="geometry" />
        </mxCell>
        <mxCell id="c-mor" value="Merge-on-Read" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;strokeWidth=1.25;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="104" width="489" height="270" as="geometry" />
        </mxCell>
        <mxCell id="cow-src" value="data file A&#xa;rows 1..n" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="56" y="146" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cow-new" value="new data file A'&#xa;rewritten; the old file leaves the snapshot" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="276" y="146" width="298" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cow-cap" value="Fast reads, costly writes. Suits read-heavy tables." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="56" y="226" width="540" height="54" as="geometry" />
        </mxCell>
        <mxCell id="mor-src" value="data file A&#xa;kept as it is" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="662" y="146" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="mor-del" value="delete file&#xa;position or equality deletes" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="882" y="146" width="203" height="54" as="geometry" />
        </mxCell>
        <mxCell id="mor-merge" value="read = data file merged with delete file&#xa;DELETE and UPDATE only append a delete file" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="662" y="226" width="445" height="54" as="geometry" />
        </mxCell>
        <mxCell id="mor-cap" value="Fast writes, merge cost on read. Suits frequent updates and CDC." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="662" y="328" width="445" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cow-src-to-cow-new" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cow-src" target="cow-new">
