        <mxCell id="title" value="VPC Lattice: Cross-VPC Service-to-Service Connectivity" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#202124;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="VPC Peering and Transit Gateway are not required. The Service Network association handles cross-VPC connectivity." style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#5f6368;fontSize=13;" vertex="1" parent="1">
