<mxfile host="kkamji-blog" type="device">
  <diagram id="analytics-stack-06-catalog-federation" name="S3 Tables nest one catalog level deeper than a regular Glue database">
    <mxGraphModel dx="934" dy="422" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="934" pageHeight="422" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="910.0" height="398.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="S3 Tables nest one catalog level deeper than a regular Glue database" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="866.0" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The extra level shows up in every ARN, which is why a policy that works for logs_db fails for a table bucket." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="866.0" height="22" as="geometry" />
        </mxCell>
        <mxCell id="defcat" value="Default catalog&#xa;AwsDataCatalog" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="176" height="134" as="geometry" />
        </mxCell>
        <mxCell id="logsdb" value="logs_db&#xa;regular Glue database" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="264" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s3tcat" value="s3tablescatalog&#xa;federated catalog" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="264" y="184" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="bucket" value="amzn-s3-demo-bucket&#xa;table bucket" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="494" y="184" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="nstable" value="sales_db &gt; orders&#xa;namespace &gt; table" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="724" y="184" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="arn1" value="Regular database ARN:  arn:aws:glue:REGION:ACCOUNT:database/logs_db" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="264" width="866" height="24" as="geometry" />
        </mxCell>
        <mxCell id="arn2" value="S3 Tables ARN:  arn:aws:glue:REGION:ACCOUNT:catalog/s3tablescatalog/{bucket}/{db}  and  table/{bucket}/{db}/{table}" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="314" width="866" height="24" as="geometry" />
        </mxCell>
        <mxCell id="arnnote" value="Deeper federation means a deeper ARN path, so a policy has to grant the ancestor ARNs as well as the target." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="364" width="866" height="24" as="geometry" />
        </mxCell>
        <mxCell id="defcat-to-logsdb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.2015;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="defcat" target="logsdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="defcat-to-s3tcat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.7985;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="defcat" target="s3tcat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3tcat-to-bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3tcat" target="bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bucket-to-nstable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bucket" target="nstable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
