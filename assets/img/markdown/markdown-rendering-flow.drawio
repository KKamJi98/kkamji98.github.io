        </mxCell>
        <mxCell id="title" value="Markdown is parsed in two passes: blocks first, then inline spans" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="951.66" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Block structure is decided before any emphasis or link is looked at, which is why indentation wins over inline syntax." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
