      "col": 0,
      "row": 0,
      "detail": "push, pull_request, schedule",
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "run",
      "kind": "box",
      "label": "Workflow run",
      "col": 1,
      "row": 0,
      "detail": "one run per matching event",
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "jobs",
      "kind": "box",
      "label": "Test and lint jobs",
      "col": 2,
      "row": 0,
      "detail": "parallel unless they need each other",
      "step": 3,
      "step_at": "top-left"
    },
    {
      "id": "runner",
      "kind": "box",
      "label": "Runner and steps",
      "col": 3,
      "row": 0,
      "detail": "a fresh environment per job",
      "step": 4,
      "step_at": "top-left"
    },
    {
      "id": "deploy",
      "kind": "box",
      "label": "Deploy job",
      "col": 4,
      "row": 0,
      "detail": "gated on the earlier jobs passing",
      "role": "store",
      "step": 5,
      "step_at": "top-left"
    }
