{
  "schema_version": 1,
  "id": "github-actions-workflow-flow",
  "title": "An event starts a run; jobs inside it are scheduled onto runners separately",
  "subtitle": "Jobs are independent unless they declare a dependency, which is what lets test and lint run at the same time.",
  "layout": {
    "icon_cell_w": 178,
    "col_gap": 56
  },
  "nodes": [
    {
      "id": "event",
