      "col": 0,
      "row": 1,
      "detail": "validate the CR spec",
      "role": "process"
    },
    {
      "id": "m3",
      "kind": "box",
      "label": "base.Reconcile",
      "col": 0,
      "row": 2,
      "detail": "namespace, RBAC, secrets, master Pod,\nAPI token, 7 hardening groovy scripts",
      "role": "process"
    },
    {
      "id": "m4",
      "kind": "box",
      "label": "waitForJenkins",
      "col": 0,
