    },
    {
      "id": "m6",
      "kind": "box",
      "label": "user.ReconcileOthers",
      "col": 0,
      "row": 5,
      "detail": "seed jobs, backup and restore jobs",
      "role": "process"
    },
    {
      "id": "e2",
      "kind": "box",
      "label": "Same error 10 times",
      "col": 1,
      "row": 5,
      "detail": "ReconcileLoopFailed, operator stops",
