<mxfile host="kkamji-blog" type="device">
  <diagram id="jenkins-operator-reconcile-walkthrough" name="One pass through jenkins_controller.go reconcile">
    <mxGraphModel dx="1024" dy="920" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1024" pageHeight="920" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1000" height="896" as="geometry" />
        </mxCell>
        <mxCell id="title" value="One pass through reconcile: base first, user configuration second" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="956" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Function order in jenkins_controller.go. Every completed step records a timestamp in the CR status; a step that fails requeues the pass." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="956" height="22" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Watch event&#xa;Jenkins CR created or changed" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="base.Validate&#xa;validate the CR spec" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="210" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="base.Reconcile&#xa;namespace, RBAC, secrets, master Pod,&#xa;API token, 7 hardening groovy scripts" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="310" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="waitForJenkins&#xa;poll readiness, requeue every 5s" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="440" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="user.ReconcileCasc&#xa;apply JCasC and user groovy scripts" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="280" height="60" as="geometry" />
        </mxCell>
