<mxfile host="kkamji-blog" type="device">
  <diagram id="jenkins-pipeline-layers" name="Pipeline definitions live in repos: seed job creates multibranch jobs that read Jenkinsfiles and load shared libraries">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#232F3E;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1176" height="676" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Where pipeline definitions live: three repositories, one Jenkins" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1132" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A seed job executes Job DSL from the central repository to create multibranch jobs. Each multibranch job reads the Jenkinsfile from its service repository, and the Jenkinsfile loads shared library code." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1132" height="22" as="geometry" />
        </mxCell>
        <mxCell id="central" value="Central repository&#xa;Job DSL scripts, one entry&#xa;per service repository" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="seed" value="Seed job&#xa;executes the DSL and creates&#xa;or updates Jenkins items" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="multibranch" value="Multibranch Pipeline job&#xa;one branch job per branch&#xa;and pull request" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="service" value="Service repository&#xa;Jenkinsfile at the root,&#xa;versioned with the code" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="780" y="400" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sharedlib" value="Shared library repository&#xa;vars, src, resources,&#xa;one version per branch or tag" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontColor=#202124;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="central" target="seed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontColor=#202124;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="seed" target="multibranch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontColor=#202124;labelBackgroundColor=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="multibranch" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontColor=#202124;labelBackgroundColor=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="service" target="sharedlib">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
