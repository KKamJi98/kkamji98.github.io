        <mxCell id="title" value="Full virtualization emulates the hardware; paravirtualization asks the guest to cooperate" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1114.99" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A paravirtualized guest needs a modified kernel, which is what buys it the cheaper hypercall path." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
