          <mxGeometry x="615.5" y="104" width="364" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f-guest" value="Unmodified guest OS&#xa;believes it owns the hardware" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="225.5" y="146" width="320" height="54" as="geometry" />
        </mxCell>
        <mxCell id="f-trap" value="Trap and emulate&#xa;privileged instructions are intercepted" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="225.5" y="218" width="320" height="54" as="geometry" />
        </mxCell>
        <mxCell id="p-guest" value="Modified guest OS&#xa;knows it is virtualized" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="637.5" y="146" width="320" height="54" as="geometry" />
        </mxCell>
