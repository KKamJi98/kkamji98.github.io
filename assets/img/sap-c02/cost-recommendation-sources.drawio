        </mxCell>
        <mxCell id="title" value="권고 도구는 서로 다른 입력을 쓰고 한 곳으로 모인다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1297.26" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Cost Explorer rightsizing 은 Compute Optimizer 결과의 부분집합이고, Cost Optimization Hub 는 세 출처의 절감액에서 중복을 제거한다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
