          <mxGeometry x="478" y="120" width="445" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cerr" value="Cost Explorer rightsizing&#xa;EC2 한정. 최대 CPU 1% 이하는 종료 권고, 추정 절감액 $0 이상만 제시" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
