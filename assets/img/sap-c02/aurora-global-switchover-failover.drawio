        <mxCell id="switchover" value="switchover&#xa;모든 클러스터가 정상일 때. 동기화를 기다린 뒤 승격하므로 RPO 0" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="681" y="104" width="266" height="54" as="geometry" />
        </mxCell>
        <mxCell id="failover" value="managed failover&#xa;리전 장애 대응. 동기화를 기다리지 않아 RPO 가 비영값, write fencing 은 best-effort" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
