          <mxGeometry x="34" y="200" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="secondary" value="secondary 리전 클러스터&#xa;읽기 전용 최대 10 개 리전, 전용 인프라 복제, 통상 1 초 미만 지연" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
