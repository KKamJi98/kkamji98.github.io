        </mxCell>
        <mxCell id="subtitle" value="secondary 동기화를 기다리는지가 RPO 를 가른다. 두 경로 모두 Global writer endpoint 값은 그대로 유지된다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
