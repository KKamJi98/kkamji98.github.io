<mxfile host="kkamji-blog" type="device">
  <diagram id="xray-parent-based-sampling" name="sampling 결정은 trace 진입 서비스에서 한 번만 일어난다">
    <mxGraphModel dx="1416" dy="392" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1416" pageHeight="392" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1392.58" height="368.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="sampling 결정은 trace 진입 서비스에서 한 번만 일어난다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1348.58" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="하위 서비스는 자신의 rule 과 무관하게 부모 결정을 따른다. 하위에만 건 100퍼센트 rule 은 적용되지 않는다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1348.58" height="22" as="geometry" />
        </mxCell>
        <mxCell id="rule-a" value="진입 서비스에 매칭되는 sampling rule&#xa;기본 rule 은 reservoir 1 에 fixed rate 5퍼센트, priority 는 1에서 9999" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="258" y="104" width="407" height="54" as="geometry" />
        </mxCell>
        <mxCell id="request" value="클라이언트 요청&#xa;trace 가 시작되는 지점" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="svc-a" value="서비스 A (진입)&#xa;여기서 sampled 여부가 결정되고 하위로 전파된다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="357" y="204" width="209" height="54" as="geometry" />
        </mxCell>
        <mxCell id="svc-b" value="서비스 B&#xa;부모 결정을 그대로 따른다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="713" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="svc-c" value="서비스 C&#xa;부모 결정을 그대로 따른다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="960" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rule-c" value="C 에만 건 fixed rate 100퍼센트 rule&#xa;진입 결정이 이미 내려져 있어 수집 비율을 바꾸지 못한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="937" y="304" width="222" height="54" as="geometry" />
        </mxCell>
        <mxCell id="traces" value="수집된 trace&#xa;진입 rule 이 정한 비율만큼만 남는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1207" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="CloudWatch agent sampling proxy&#xa;SDK 와 ADOT 가 TCP 2000 으로 sampling API 를 호출한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="309" y="304" width="305" height="54" as="geometry" />
        </mxCell>
        <mxCell id="request-to-svc-a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="request" target="svc-a">
          <mxGeometry relative="1" as="geometry" />
