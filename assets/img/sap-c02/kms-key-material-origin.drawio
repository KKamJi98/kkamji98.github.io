<mxfile host="kkamji-blog" type="device">
  <diagram id="kms-key-material-origin" name="key material 을 어디서 만드느냐가 이후 선택지를 잠근다">
    <mxGraphModel dx="1262" dy="420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1262" pageHeight="420" math="0" shadow="0" background="#FFFFFF">
      <root>
