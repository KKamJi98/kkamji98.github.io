        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1238.36" height="396.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="key material 을 어디서 만드느냐가 이후 선택지를 잠근다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1194.36" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="origin 은 키 생성 시점에 결정되고 나중에 바꿀 수 없다. rotation 과 multi-Region key 의 가능 여부가 여기서 갈린다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1194.36" height="22" as="geometry" />
        </mxCell>
        <mxCell id="requirement" value="키 소재를 누가 만들고 어디에 두는가&#xa;키 생성 시점에 한 번만 정한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="234" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="origin-kms" value="AWS_KMS origin&#xa;KMS 가 관리형 HSM 에서 생성한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="273" y="120" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="origin-external" value="EXTERNAL origin&#xa;내가 만든 material 을 임포트한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="273" y="234" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="origin-cloudhsm" value="CloudHSM key store&#xa;내 계정의 전용 HSM cluster 안에 둔다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="266" y="332" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cap-kms" value="자동 rotation 90-2560일&#xa;on-demand rotation, multi-Region key, asymmetric, HMAC 전부 가능" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="531" y="120" width="407" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cap-external" value="자동 rotation 불가&#xa;on-demand rotation 키당 25회와 수동 교체만, multi-Region key 는 가능" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="544" y="234" width="381" height="54" as="geometry" />
        </mxCell>
