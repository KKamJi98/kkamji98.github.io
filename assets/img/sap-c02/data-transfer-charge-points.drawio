          <mxGeometry x="435" y="584" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="internet" value="인터넷&#xa;인터넷 egress 는 월 100 GB 무료. 중국과 GovCloud 는 제외" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.internet_alt1;" vertex="1" parent="1">
