        </mxCell>
        <mxCell id="subtitle" value="private subnet 에서 출발한 트래픽이 통과하는 다섯 경로와 각 경로에 붙는 요금이다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="970.26" height="22" as="geometry" />
        </mxCell>
        <mxCell id="source" value="private subnet 의 EC2 와 ECS&#xa;같은 AZ 안의 private IP 통신은 과금되지 않는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3E8FD;strokeColor=#A142F4;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="228" height="566" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="NAT Gateway&#xa;시간당 요금과 처리 GB 당 요금이 함께 붙는다" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;" vertex="1" parent="1">
          <mxGeometry x="435" y="104" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="gwep" value="gateway endpoint&#xa;추가 요금 없음. route table 의 prefix list 로 라우팅된다" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1">
          <mxGeometry x="435" y="232" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ifep" value="interface endpoint&#xa;AZ 당 provisioned 시간 요금과 처리 GB 당 요금" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.privatelink;" vertex="1" parent="1">
          <mxGeometry x="435" y="360" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="hop" value="다른 AZ 또는 다른 리전&#xa;AZ 경계와 리전 경계를 넘으면 전송 요금이 붙는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
