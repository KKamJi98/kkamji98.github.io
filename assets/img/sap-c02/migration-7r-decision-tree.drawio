        <mxCell id="q-change" value="옮기면서 무엇을 바꾸는가&#xa;OS 와 애플리케이션 코드의 변경 범위" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
