        </mxCell>
        <mxCell id="out-relocate" value="relocate&#xa;아키텍처 변경 없음, 재구매와 재작성 없음" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
