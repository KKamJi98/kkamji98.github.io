<mxfile host="kkamji-blog" type="device">
  <diagram id="migration-7r-decision-tree" name="7R 은 질문 다섯 개를 순서대로 통과한 결과다">
    <mxGraphModel dx="1204" dy="780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1204" pageHeight="780" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1180.24" height="756.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="7R 은 질문 다섯 개를 순서대로 통과한 결과다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1136.24" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="분류가 먼저 오는 것이 아니라 사용률, 등가물, 대체 가능성, 이동 단위, 변경 범위 순으로 걸러진다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1136.24" height="22" as="geometry" />
        </mxCell>
        <mxCell id="assessment" value="포트폴리오 평가 완료&#xa;사용률, 의존성, 라이선스, 소유자 수집" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="q-used" value="아직 쓰이고 있는가&#xa;90일 평균 사용률과 inbound connection" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="130" y="202" width="215" height="54" as="geometry" />
        </mxCell>
        <mxCell id="out-retire" value="retire&#xa;5% 미만은 zombie, 5%에서 20%는 idle" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="587" y="202" width="209" height="54" as="geometry" />
        </mxCell>
        <mxCell id="q-equivalent" value="클라우드 등가물이 있는가&#xa;mainframe, mid-range, non-x86 Unix 여부" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="107" y="300" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="out-retain" value="retain&#xa;IBM AS/400, Oracle Solaris, 데이터 residency 규제" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="539" y="300" width="305" height="54" as="geometry" />
        </mxCell>
        <mxCell id="q-saas" value="상용 제품으로 대체할 수 있는가&#xa;라이선스에서 SaaS 로 이동 가능성" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="149" y="398" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="out-repurchase" value="repurchase&#xa;구매 뒤에 교육, 데이터 이전, AD 통합, 네트워킹이 남는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="571" y="398" width="241" height="54" as="geometry" />
        </mxCell>
        <mxCell id="q-unit" value="이동 단위가 서버인가 플랫폼인가&#xa;플랫폼 통째 또는 다른 VPC, Region, 계정" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
