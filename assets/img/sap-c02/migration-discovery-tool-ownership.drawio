        </mxCell>
        <mxCell id="title" value="수집 도구마다 대답할 수 있는 질문이 다르다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
