        </mxCell>
        <mxCell id="subtitle" value="돈 이야기, 기술 인벤토리, 진행 추적은 서로 다른 도구가 맡고 한 도구가 셋을 다 하지 않는다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
