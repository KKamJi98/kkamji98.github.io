        </mxCell>
        <mxCell id="estate" value="온프레미스 자산&#xa;VMware VM 과 물리 서버가 섞여 있다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="202" width="177" height="54" as="geometry" />
        </mxCell>
        <mxCell id="agentless" value="ADS Agentless Collector&#xa;vCenter 에 OVA 1개, 약 60분 주기, VMware VM 전용, running process 수집 불가" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
