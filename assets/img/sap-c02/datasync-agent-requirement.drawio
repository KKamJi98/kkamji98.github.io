  <diagram id="datasync-agent-requirement" name="DataSync 에이전트 필요 여부가 태스크 처리량 상한까지 결정한다">
    <mxGraphModel dx="883" dy="884" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="883" pageHeight="884" math="0" shadow="0" background="#FFFFFF">
