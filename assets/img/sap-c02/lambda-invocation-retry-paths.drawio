        </mxCell>
        <mxCell id="async-source" value="비동기 소스&#xa;S3 알림, SNS, EventBridge. payload 1 MB" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
