        </mxCell>
        <mxCell id="async-queue" value="Lambda 내부 이벤트 큐&#xa;202 를 즉시 돌려준다. eventually consistent 라 중복 전달이 있다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
