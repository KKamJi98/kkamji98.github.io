        <mxCell id="small" value="128 KB 미만 객체&#xa;모니터링과 자동 계층 이동 대상이 아니고 항상 Frequent Access 에 남는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
