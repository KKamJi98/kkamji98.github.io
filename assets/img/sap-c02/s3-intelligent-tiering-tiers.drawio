        </mxCell>
        <mxCell id="frequent" value="Frequent Access&#xa;기본 계층. 접근이 발생하면 어느 계층에서든 여기로 돌아온다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
