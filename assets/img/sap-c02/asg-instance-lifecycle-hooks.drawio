        </mxCell>
        <mxCell id="hook-term-result" value="termination hook 결과&#xa;기본이 best effort 다. timeout 이나 ABANDON 이면 즉시 종료로 진행한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
