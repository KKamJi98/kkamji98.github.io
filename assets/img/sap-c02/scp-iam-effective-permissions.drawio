        </mxCell>
        <mxCell id="subtitle" value="SCP는 한도를 정할 뿐 권한을 주지 않는다. 셋 중 하나라도 허용하지 않으면 요청은 거부된다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
