<mxfile host="kkamji-blog" type="device">
  <diagram id="rto-rpo-timeline" name="RPO 는 재해 이전 구간이고 RTO 는 재해 이후 구간이다">
    <mxGraphModel dx="1575" dy="294" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1575" pageHeight="294" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1551.98" height="270.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="RPO 는 재해 이전 구간이고 RTO 는 재해 이후 구간이다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1507.98" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="두 값은 목표이고, 실제 상한은 복제 수단과 복구 절차가 정한다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1507.98" height="22" as="geometry" />
        </mxCell>
        <mxCell id="last-point" value="마지막 복구 가능 지점&#xa;복제나 백업이 확보한 마지막 일관 상태" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rpo-window" value="RPO 구간&#xa;허용하는 데이터 손실 시간" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="416" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="incident" value="재해 발생&#xa;장애를 인지한 시점이 아니라 발생 시점" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="799" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rto-window" value="RTO 구간&#xa;허용하는 서비스 중단 시간" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1082" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="서비스 재개&#xa;정상 트래픽 처리 복귀" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1366" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rpo-driver" value="RPO 의 실제 상한&#xa;복제 수단이 정한다. Aurora Global 초 단위, S3 RTC 15 분 임계값, EFS replication 15 분, 백업 주기" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="250" y="206" width="509" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rto-driver" value="RTO 의 실제 상한&#xa;복구 절차가 정한다. 탐지와 판단, DNS 전파, 인스턴스 기동, 용량 확장의 합" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1015" y="206" width="311" height="54" as="geometry" />
        </mxCell>
        <mxCell id="last-point-to-rpo-window" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="last-point" target="rpo-window">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rpo-window-to-incident" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#232F3E;strokeWidth=1.25;endArrow=classic;endFill=1;endSize=7;fontSize=11;fontColor=#202124;labelBackgroundColor=none;jettySize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rpo-window" target="incident">
