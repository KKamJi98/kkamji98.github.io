<mxfile host="kkamji-blog" type="device">
  <diagram id="storage-gateway-four-types" name="온프레미스가 요구하는 인터페이스가 Storage Gateway 종류를 정한다">
    <mxGraphModel dx="827" dy="614" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="614" math="0" shadow="0" background="#FFFFFF">
      <root>
