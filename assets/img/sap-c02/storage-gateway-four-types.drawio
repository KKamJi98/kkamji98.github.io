        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="803.46" height="590.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="온프레미스가 요구하는 인터페이스가 Storage Gateway 종류를 정한다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="759.46" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="같은 게이트웨이 제품군이지만 프로토콜과 백엔드 저장 형태가 짝으로 고정돼 있다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="759.46" height="22" as="geometry" />
        </mxCell>
        <mxCell id="iface-file" value="NFS 또는 SMB 파일 접근&#xa;파일을 객체로 후속 처리한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="120" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="iface-smb-fsx" value="SMB 접근에 Windows 원본이 필요&#xa;AD 통합 파일 서버를 그대로 쓴다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="250" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="iface-block" value="iSCSI 블록 장치&#xa;애플리케이션이 블록에 직접 쓴다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="380" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="iface-vtl" value="iSCSI 가상 테이프 라이브러리&#xa;기존 백업 소프트웨어와 카탈로그 유지" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="510" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="gw-s3file" value="S3 File Gateway&#xa;file share 하나가 버킷 하나. 파일 상한 5 TiB" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="268" y="120" width="235" height="54" as="geometry" />
        </mxCell>
        <mxCell id="gw-fsxfile" value="Amazon FSx File Gateway&#xa;신규 고객에게 제공되지 않는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="297" y="250" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="gw-volume" value="Volume Gateway&#xa;cached 32 TiB, stored 16 TiB" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="284" y="380" width="203" height="54" as="geometry" />
        </mxCell>
        <mxCell id="gw-tape" value="Tape Gateway&#xa;테이프 100 GiB 에서 15 TiB" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
