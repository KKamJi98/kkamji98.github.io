          <mxGeometry x="34" y="296" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="need-windows" value="Windows, custom AMI 와 CNI, launch template 부트스트랩&#xa;Pod 별 security group(SGPP)은 Linux 전용; Local Zone은 Auto Mode도 지원" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
