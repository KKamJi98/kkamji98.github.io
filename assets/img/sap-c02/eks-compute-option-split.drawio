  <diagram id="eks-compute-option-split" name="EKS 컴퓨트는 포기할 수 없는 요구 하나가 선택을 확정한다">
    <mxGraphModel dx="1177" dy="608" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1177" pageHeight="608" math="0" shadow="0" background="#FFFFFF">
