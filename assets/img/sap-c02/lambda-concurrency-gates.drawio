<mxfile host="kkamji-blog" type="device">
  <diagram id="lambda-concurrency-gates" name="요청이 스로틀되는 게이트는 세 군데다">
    <mxGraphModel dx="1441" dy="492" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1441" pageHeight="492" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1417.2" height="468.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="요청이 스로틀되는 게이트는 세 군데다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="1373.2" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="rps 상한, 함수 동시성, 스케일 속도 중 먼저 걸리는 곳에서 429 가 난다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1373.2" height="22" as="geometry" />
        </mxCell>
        <mxCell id="incoming" value="함수 호출&#xa;동기와 비동기 모두 같은 게이트를 지난다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="79" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rps-gate" value="rps 게이트&#xa;동시성 쿼터의 10배. 기본 1,000 이면 10,000 rps" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="352" y="204" width="247" height="54" as="geometry" />
        </mxCell>
        <mxCell id="concurrency-gate" value="함수 동시성&#xa;reserved 를 걸면 그 값이 상한이자 하한이다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="658" y="204" width="203" height="54" as="geometry" />
        </mxCell>
        <mxCell id="scale-gate" value="스케일 속도&#xa;함수당 10초에 실행 환경 1,000개" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="919" y="204" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="warm-env" value="provisioned 실행 환경&#xa;초기화가 끝나 있다. 과금 대상이고 reserved 를 넘지 못한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1147" y="104" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cold-env" value="새 실행 환경&#xa;초기화부터 시작한다. 콜드 스타트가 여기서 난다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="1182" y="304" width="190" height="54" as="geometry" />
        </mxCell>
        <mxCell id="throttled" value="429 TooManyRequestsException&#xa;동기는 호출자에게, 비동기는 큐로 되돌려 6시간 재시도" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
