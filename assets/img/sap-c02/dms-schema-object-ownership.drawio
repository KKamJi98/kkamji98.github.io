  <diagram id="dms-schema-object-ownership" name="DMS 는 데이터를 옮기고 변환 도구는 스키마를 옮긴다">
    <mxGraphModel dx="1470" dy="424" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1470" pageHeight="424" math="0" shadow="0" background="#FFFFFF">
