        <mxCell id="p-relational" value="관계형 스키마와 조인, 읽기 확장&#xa;reader 를 여러 개 두고 failover 도 필요" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="468" width="215" height="54" as="geometry" />
