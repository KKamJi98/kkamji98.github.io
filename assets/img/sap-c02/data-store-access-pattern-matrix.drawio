        <mxCell id="title" value="액세스 패턴이 데이터 계층을 고른다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="521.08" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="서비스 이름이 아니라 지문에 적힌 액세스 패턴이 선지를 좁힌다. 각 상자의 부제가 그 선택을 강제하는 제약이다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="521.08" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p-key" value="키 하나로 아이템 조회&#xa;초당 수십만 건, 스키마가 유동적" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="54" y="120" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s-ddb" value="DynamoDB&#xa;아이템 400 KB, 1 MB 페이지, LSI 는 생성 시점에만" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="408" y="104" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p-microsec" value="같은 아이템에 읽기가 집중&#xa;마이크로초 지연, 코드 변경 최소화" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="54" y="236" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s-dax" value="DAX&#xa;eventually consistent 읽기만 가속, VPC 전용" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="408" y="220" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p-session" value="세션과 리더보드, 복합 자료구조&#xa;여러 데이터 소스 앞단 캐싱" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="54" y="352" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="s-cache" value="ElastiCache&#xa;cache-aside 로직은 애플리케이션이 쓴다" style="sketch=0;outlineConnect=0;gradientColor=none;html=0;whiteSpace=nowrap;fontSize=11;fontStyle=0;fontColor=#202124;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelBackgroundColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;" vertex="1" parent="1">
          <mxGeometry x="408" y="336" width="48" height="48" as="geometry" />
