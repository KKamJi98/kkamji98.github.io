<mxfile host="kkamji-blog" type="device">
  <diagram id="data-store-access-pattern-matrix" name="액세스 패턴이 데이터 계층을 고른다">
    <mxGraphModel dx="589" dy="1036" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="589" pageHeight="1036" math="0" shadow="0" background="#FFFFFF">
