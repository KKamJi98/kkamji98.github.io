<mxfile host="kkamji-blog" type="device">
  <diagram id="iam-policy-evaluation-order" name="요청은 일곱 단계를 순서대로 통과해야 허용된다">
    <mxGraphModel dx="1066" dy="392" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1066" pageHeight="392" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="1042.86" height="368.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="요청은 일곱 단계를 순서대로 통과해야 허용된다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="998.86" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="첫 단계에서 explicit Deny 를 한 번에 훑고, 이후 단계는 순서대로 걸러낸다. 어느 단계에서든 떨어지면 거부다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="998.86" height="22" as="geometry" />
        </mxCell>
        <mxCell id="request" value="API 요청&#xa;기본값은 implicit deny" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EAED;strokeColor=#6B7280;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="34" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="deny-eval" value="1. Deny evaluation&#xa;여섯 정책 타입 전체에서 explicit Deny 를 찾는다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="254" y="104" width="235" height="54" as="geometry" />
        </mxCell>
        <mxCell id="rcp" value="2. RCP&#xa;RCPFullAWSAccess 가 항상 붙어 있다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="533" y="104" width="196" height="54" as="geometry" />
        </mxCell>
        <mxCell id="scp" value="3. SCP&#xa;조직이 정한 상한" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="815" y="104" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="resource-policy" value="4. resource-based policy&#xa;지목한 ARN 종류가 뒤 단계를 바꾼다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="814" y="204" width="177" height="54" as="geometry" />
        </mxCell>
        <mxCell id="identity-policy" value="5. identity-based policy&#xa;권한을 실제로 부여한다" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8F0FE;strokeColor=#1A73E8;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="542" y="204" width="177" height="54" as="geometry" />
        </mxCell>
