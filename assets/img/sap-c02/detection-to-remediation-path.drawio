        </mxCell>
        <mxCell id="subtitle" value="서비스마다 답하는 질문이 다르다. Detective 는 탐지하지 않고 조사하며, Config 는 rule 위반을 SSM Automation 으로 직접 닫는다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="1047.5" height="22" as="geometry" />
        </mxCell>
