        </mxCell>
        <mxCell id="title" value="탐지가 자동 교정으로 이어지려면 집계와 라우팅과 실행이 각각 다른 서비스에 있다" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
