<mxfile host="kkamji-blog" type="device">
  <diagram id="detection-to-remediation-path" name="탐지가 자동 교정으로 이어지려면 집계와 라우팅과 실행이 각각 다른 서비스에 있다">
    <mxGraphModel dx="1115" dy="576" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1115" pageHeight="576" math="0" shadow="0" background="#FFFFFF">
