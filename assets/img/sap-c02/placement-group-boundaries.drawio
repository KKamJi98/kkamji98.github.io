        </mxCell>
        <mxCell id="subtitle" value="cluster 는 AZ 를 넘지 못하고, partition 은 AZ 당 7개까지, rack-level spread 는 AZ 당 running 7대까지다." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
