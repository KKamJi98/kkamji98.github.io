{
  "schema_version": 1,
  "id": "rag-05-secure-rag-flow",
  "title": "Access tags are written at ingestion and enforced again at query time",
  "subtitle": "Filtering only at retrieval is not enough: what was never tagged cannot be filtered later.",
  "layout": {
    "col_gap": 42,
    "row_gap": 34
  },
  "containers": [
    {
      "id": "ingest",
      "kind": "plain",
      "label": "Ingestion: sanitize and tag",
      "members": [
        "docs",
        "pii",
        "tag",
        "emb",
        "vdb"
      ]
    },
    {
      "id": "query",
      "kind": "plain",
      "label": "Query: zero trust",
      "members": [
        "userq",
        "retr",
        "perm",
        "inj",
        "llm",
        "ans"
      ]
    }
  ],
  "nodes": [
    {
      "id": "docs",
      "kind": "box",
      "label": "Documents",
      "col": 0,
      "row": 0
    },
    {
      "id": "pii",
      "kind": "box",
      "label": "PII redaction",
      "col": 1,
      "row": 0,
      "detail": "before anything is embedded",
      "role": "danger"
    },
    {
      "id": "tag",
      "kind": "box",
      "label": "Access tagging",
      "col": 2,
      "row": 0,
      "detail": "who may see this chunk",
      "role": "compute"
    },
    {
      "id": "emb",
      "kind": "box",
      "label": "Embedding",
      "col": 3,
      "row": 0
    },
    {
      "id": "vdb",
      "kind": "box",
      "label": "Vector index",
      "col": 4,
      "row": 0,
      "detail": "text plus access tags",
      "role": "store"
    },
    {
      "id": "userq",
      "kind": "box",
      "label": "User query with role",
      "col": 0,
      "row": 1
    },
    {
      "id": "retr",
      "kind": "box",
      "label": "Retrieval",
      "col": 1,
      "row": 1,
      "detail": "candidates by similarity"
    },
    {
      "id": "perm",
      "kind": "box",
      "label": "Permission filter",
      "col": 2,
      "row": 1,
      "detail": "drops chunks the role may not see",
      "role": "danger"
    },
    {
      "id": "inj",
      "kind": "box",
      "label": "Injection check",
      "col": 3,
      "row": 1,
      "detail": "on retrieved content, not just input",
      "role": "danger"
    },
    {
      "id": "llm",
      "kind": "box",
      "label": "LLM generation",
      "col": 4,
      "row": 1
    },
    {
      "id": "ans",
      "kind": "box",
      "label": "Answer with citations",
      "col": 5,
      "row": 1,
      "role": "store"
    }
  ],
  "edges": [
    {
      "id": "docs-to-pii",
      "source": "docs",
      "target": "pii"
    },
    {
      "id": "pii-to-tag",
      "source": "pii",
      "target": "tag"
    },
    {
      "id": "tag-to-emb",
      "source": "tag",
      "target": "emb"
    },
    {
      "id": "emb-to-vdb",
      "source": "emb",
      "target": "vdb"
    },
    {
      "id": "userq-to-retr",
      "source": "userq",
      "target": "retr"
    },
    {
      "id": "retr-to-perm",
      "source": "retr",
      "target": "perm"
    },
    {
      "id": "perm-to-inj",
      "source": "perm",
      "target": "inj"
    },
    {
      "id": "inj-to-llm",
      "source": "inj",
      "target": "llm"
    },
    {
      "id": "llm-to-ans",
      "source": "llm",
      "target": "ans"
    },
    {
      "id": "vdb-to-retr",
      "source": "vdb",
      "target": "retr",
      "dashed": true
    }
  ]
}
