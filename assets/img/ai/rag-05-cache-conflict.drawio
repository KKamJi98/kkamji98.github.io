<mxfile host="kkamji-blog" type="device">
  <diagram id="rag-05-cache-conflict" name="A semantic cache keyed on the query alone leaks across roles">
    <mxGraphModel dx="935" dy="272" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="935" pageHeight="272" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" value="" style="rounded=0;html=0;fillColor=none;strokeColor=#5F6368;fontColor=#202124;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="12" y="12" width="911.1" height="248.0" as="geometry" />
        </mxCell>
        <mxCell id="title" value="A semantic cache keyed on the query alone leaks across roles" style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#202124;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="34" width="867.1" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two users can send the same question and be entitled to different documents, so the role has to be part of the key." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="34" y="64" width="867.1" height="22" as="geometry" />
        </mxCell>
        <mxCell id="userA" value="User A (role: HR)&#xa;entitled to HR documents" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="105.77" y="104" width="177" height="54" as="geometry" />
        </mxCell>
        <mxCell id="userB" value="User B (role: Eng)&#xa;not entitled to them" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#5F6368;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="106.77" y="184" width="176" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="Semantic cache&#xa;key = query embedding" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FEF7E0;strokeColor=#B06000;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="334.77" y="104" width="176" height="134" as="geometry" />
        </mxCell>
        <mxCell id="out1" value="Shared key&#xa;User B receives User A's HR documents" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FCE8E6;strokeColor=#EA4335;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
          <mxGeometry x="565.77" y="104" width="260" height="54" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="Per-role key&#xa;isolated and safe, at a lower hit rate" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E6F4EA;strokeColor=#34A853;fontColor=#202124;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=1.25;" vertex="1" parent="1">
