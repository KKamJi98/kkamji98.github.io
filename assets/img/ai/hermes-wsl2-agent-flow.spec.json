{
  "schema_version": 1,
  "id": "hermes-wsl2-agent-flow",
  "title": "Provider and runtime are separate choices, not one setting",
  "subtitle": "The provider decides how the model is authenticated and called. The runtime decides which loop handles a turn. A systemd service keeps the gateway alive inside WSL2.",
