    "col_gap": 48,
    "row_gap": 52
  },
  "nodes": [
    {
      "id": "user",
      "kind": "box",
      "label": "User",
      "detail": "one session, two entry points",
      "col": 0,
      "row": 0,
      "rowspan": 2,
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "terminal",
      "kind": "box",
      "label": "Terminal",
      "detail": "inside WSL2",
      "col": 1,
      "row": 0,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "telegram",
      "kind": "box",
      "label": "Telegram gateway",
      "detail": "reaching the agent from outside the terminal",
      "col": 1,
      "row": 1
    },
    {
      "id": "runtime",
      "kind": "box",
      "label": "Hermes runtime",
      "detail": "standard chat loop, or the Codex app-server path",
      "col": 2,
      "row": 0,
      "rowspan": 2,
      "step": 3,
      "step_at": "top-left",
      "role": "compute"
    },
    {
      "id": "provider",
      "kind": "box",
      "label": "openai-codex provider",
      "detail": "authentication and model call path",
      "col": 3,
      "row": 0,
      "rowspan": 2,
      "step": 4,
      "step_at": "top-left",
      "role": "process"
    },
    {
      "id": "model",
      "kind": "box",
      "label": "Model turn",
      "detail": "tool loop runs under the chosen runtime",
      "col": 4,
      "row": 0,
      "rowspan": 2,
      "role": "store"
    },
    {
      "id": "systemd",
      "kind": "box",
      "label": "systemd service",
      "detail": "supervises the gateway process in WSL2",
      "col": 1,
      "row": 2,
      "role": "queue"
    }
