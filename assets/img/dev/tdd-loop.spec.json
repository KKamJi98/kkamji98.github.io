{
  "schema_version": 1,
  "id": "tdd-loop",
  "title": "TDD runs one small red-green-refactor loop per behavior",
  "subtitle": "The failing test is written first and proves the behavior is missing before any implementation exists.",
  "layout": {
    "col_gap": 64
  },
  "nodes": [
    {
      "id": "red",
      "kind": "box",
      "label": "RED",
      "detail": "write one failing test",
      "role": "danger",
      "col": 0,
      "row": 0,
      "step": 1,
      "step_at": "top-left"
    },
    {
      "id": "green",
      "kind": "box",
      "label": "GREEN",
      "detail": "smallest implementation",
      "role": "process",
      "col": 1,
      "row": 0,
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "refactor",
      "kind": "box",
      "label": "REFACTOR",
      "detail": "clean up, tests stay green",
      "role": "process",
      "col": 2,
      "row": 0,
      "step": 3,
      "step_at": "top-left"
    },
    {
      "id": "next",
      "kind": "box",
      "label": "Next behavior",
      "detail": "back to RED with a new test",
      "role": "external",
      "col": 3,
      "row": 0,
      "step": 4,
      "step_at": "top-left"
    }
  ],
  "edges": [
    {
      "id": "red-to-green",
      "source": "red",
      "target": "green",
      "emphasis": true
    },
    {
      "id": "green-to-refactor",
      "source": "green",
      "target": "refactor"
    },
    {
      "id": "refactor-to-next",
      "source": "refactor",
      "target": "next"
    }
  ]
}
