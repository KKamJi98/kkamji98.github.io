        </mxCell>
        <mxCell id="subtitle" value="The same credentials and the same port as SSH apply, which is why disabling SSH also disables SFTP." style="text;html=0;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#5F6368;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1">
