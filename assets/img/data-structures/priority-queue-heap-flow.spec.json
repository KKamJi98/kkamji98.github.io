      "step_at": "top-left"
    },
    {
      "id": "heap",
      "kind": "box",
      "label": "Binary heap",
      "col": 1,
      "row": 0,
      "detail": "parent always outranks its children",
      "step": 2,
      "step_at": "top-left"
    },
    {
      "id": "top",
      "kind": "box",
      "label": "Highest priority at the root",
